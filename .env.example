# Optional public deployment values. Never put credentials in VITE_* variables.
# The default configuration is the requested GitHub Pages user site.
# VITE_BASE_PATH=/
# VITE_SITE_URL=https://ahtishamasghar.github.io

# For a project site, set both values together:
# VITE_BASE_PATH=/portfolio/
# VITE_SITE_URL=https://ahtishamasghar.github.io/portfolio
